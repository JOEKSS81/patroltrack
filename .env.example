# ─────────────────────────────────────────
# PatrolTrack — Variables d'entorn
# Copia aquest fitxer com .env i omple'l
# ─────────────────────────────────────────

# ── Telegram ──────────────────────────────
# Obtén API_ID i API_HASH a: https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890

# IDs o usernames dels grups de Telegram a escoltar
# Pots posar el username (@nom_grup) o l'ID numèric (-100xxxxxxxxxx)
# Troba l'ID d'un grup reenviant un missatge a @userinfobot
TELEGRAM_GROUPS=@nom_grup_1,@nom_grup_2,-1001234567890

# ── WhatsApp ──────────────────────────────
# Fragments del nom dels grups de WhatsApp a escoltar (minúscules)
# Deixa buit per escoltar tots els grups
WA_GROUPS=lleida,ponent,carreteres

# ── Backend ───────────────────────────────
BACKEND_URL=http://localhost:8000
